import /init.recovery.teei_daemon.rc

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.ffs.aio_compat 1

on fs
    install_keyring

on fs && property:ro.debuggable=0
    # distinguish USB shoulde connect or not, i.e. CDP vs SDP
    write /sys/class/udc/musb-hdrc/device/cmode 2
    # set charging free due to it wait for USB activation
    start adbd

on post-fs
    # Support A/B feature for emmc boot region
    symlink /dev/block/sda /dev/block/mmcblk0boot0
    symlink /dev/block/sdb /dev/block/mmcblk0boot1
    symlink /dev/block/mmcblk0boot0 /dev/block/platform/bootdevice/by-name/preloader_a
    symlink /dev/block/mmcblk0boot1 /dev/block/platform/bootdevice/by-name/preloader_b

    # Symlink by-name directory
    symlink /dev/block/platform/bootdevice/by-name /dev/block/by-name

    # Symlink para to misc for BCB (fastbootd / clear recovery boot loop)
    symlink /dev/block/platform/bootdevice/by-name/para /dev/block/platform/bootdevice/by-name/misc
    symlink /dev/block/platform/bootdevice/by-name/para /dev/block/by-name/misc

    # Smart clear BCB in para: clear boot-recovery to prevent bootloop, preserve boot-fastboot
    exec u:r:recovery:s0 -- /system/bin/check_bcb.sh

    # OrangeFox startup script & binary symlinks
    symlink /system/bin/foxstart.sh /sbin/foxstart.sh
    symlink /system/bin/rebootfastboot.sh /sbin/rebootfastboot.sh
    symlink /system/bin/fastbootd /sbin/fastbootd
    symlink /system/bin/recovery /sbin/recovery

    # Fstab symlinks for fs_mgr and libbootloader_message
    symlink /system/etc/recovery.fstab /fstab.mt6765
    symlink /system/etc/recovery.fstab /etc/recovery.fstab

service keystore_auth /system/bin/keystore_auth
    oneshot
    user system
    group root
    disabled
    seclabel u:r:recovery:s0

service keystore /system/bin/keystore /tmp/misc/keystore
    user root
    group root drmrpc readproc
    disabled
    seclabel u:r:recovery:s0

service gatekeeper-1-0 /system/bin/android.hardware.gatekeeper@1.0-service
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service keymaster-4-0 /system/bin/android.hardware.keymaster@4.0-service.beanpod
    user root
    group root drmrpc
    disabled
    seclabel u:r:recovery:s0

on property:hwservicemanager.ready=true && property:init.svc.teei_daemon=running
    start keymaster-4-0
    start gatekeeper-1-0

on property:ro.crypto.state=unsupported
    stop teei_daemon
    stop keymaster-4-0
    stop gatekeeper-1-0

on property:ro.crypto.state=unencrypted
    stop teei_daemon
    stop keymaster-4-0
    stop gatekeeper-1-0

on property:twrp.decrypt.done=true && property:twrp.all.users.decrypted=true
    stop teei_daemon
    stop keymaster-4-0
    stop gatekeeper-1-0
